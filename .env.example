# Defaults to a browser-only simulation. Live mode requires all relevant contacts.
DEMO_MODE=true
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=data/blockops.sqlite
OPERATOR_PASSWORD=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
RESIDENT_ACCESS_CODE=replace-with-a-shared-resident-code
LIVE_DISPATCH=false
# An HTTPS automation endpoint (n8n / Make / your own gateway).
# Receives signed JSON and an Idempotency-Key. It must acknowledge durable receipt.
DISPATCH_WEBHOOK_URL=
DISPATCH_WEBHOOK_SECRET=
# Approved contacts only. IDs map to the route table in src/domain.ts.
CONTRACTORS_JSON=[]
MANAGER_PHONE=
# Official Twilio WhatsApp and voice entry points; optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Only verified resident numbers can submit through WhatsApp/voice.
RESIDENT_PHONES=
# Vercel injects this when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Resend email intake and replies. Put real secrets in Vercel project settings.
EMAIL_INBOX=reports@blockops.january.ie
EMAIL_FROM=reports@blockops.january.ie
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
